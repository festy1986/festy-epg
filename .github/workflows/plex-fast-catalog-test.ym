name: Plex FAST Catalog Test

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  discover:
    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - name: Test Plex FAST channel catalog
        shell: bash
        run: |
          cat > plex_fast_catalog_test.py <<'PY'
          import json
          import os
          import urllib.error
          import urllib.request
          from datetime import datetime, timezone

          BASE = "https://epg.provider.plex.tv"

          HEADERS = {
              "Accept": "application/json",
              "User-Agent": "Plex-FAST-Catalog-Test/1.0",
              "X-Plex-Product": "Plex FAST Catalog Test",
              "X-Plex-Client-Identifier": "plex-fast-catalog-test",
          }

          GENRES = [
              "bingeworthy", "movies", "crime", "news", "sports",
              "reality", "classic-tv", "adrenaline-sci-fi", "comedy",
              "daytime-tv-games", "explore", "food-home-culture",
              "kids-family", "en-espanol", "global", "music",
          ]

          PATHS = [
              ("featured", "/lineups/plex/channels/featured"),
          ] + [
              (genre, f"/lineups/plex/channels?genre={genre}")
              for genre in GENRES
          ]

          def fetch(path):
              url = BASE + path
              req = urllib.request.Request(url, headers=HEADERS)

              try:
                  with urllib.request.urlopen(req, timeout=15) as response:
                      raw = response.read()
                      try:
                          body = json.loads(raw.decode("utf-8"))
                      except Exception:
                          body = {
                              "raw_preview": raw[:2000].decode(
                                  "utf-8", errors="replace"
                              )
                          }

                      return {
                          "url": url,
                          "status": response.status,
                          "content_type": response.headers.get(
                              "Content-Type", ""
                          ),
                          "bytes": len(raw),
                          "body": body,
                      }

              except urllib.error.HTTPError as exc:
                  raw = exc.read(3000).decode(
                      "utf-8", errors="replace"
                  )
                  try:
                      body = json.loads(raw)
                  except Exception:
                      body = {"raw_preview": raw}

                  return {
                      "url": url,
                      "status": exc.code,
                      "error": str(exc.reason),
                      "body": body,
                  }

              except Exception as exc:
                  return {
                      "url": url,
                      "error": f"{type(exc).__name__}: {exc}",
                  }

          report = {
              "tested_at_utc": datetime.now(timezone.utc).isoformat(),
              "authentication": "No Plex token supplied",
              "results": [],
              "channels_found": [],
          }

          for name, path in PATHS:
              result = fetch(path)
              result["category"] = name
              report["results"].append(result)

              status = result.get("status", "ERROR")
              print(
                  f"{name}: HTTP {status}; "
                  f"bytes={result.get('bytes', 0)}"
              )

          def walk(obj, source, found):
              if isinstance(obj, dict):
                  lower = {str(k).lower(): v for k, v in obj.items()}

                  # Capture objects that look like channel records.
                  name = (
                      lower.get("title")
                      or lower.get("name")
                      or lower.get("channelname")
                  )
                  logo = None
                  for key in ("images", "image", "clearlogo", "logo"):
                      if key in lower:
                          logo = lower[key]
                          break

                  if name and any(
                      key in lower for key in (
                          "id", "key", "channelid", "channelgridkey",
                          "images", "image", "clearlogo", "logo"
                      )
                  ):
                      found.append({
                          "source_category": source,
                          "record": obj,
                      })

                  for value in obj.values():
                      walk(value, source, found)

              elif isinstance(obj, list):
                  for item in obj:
                      walk(item, source, found)

          for result in report["results"]:
              if result.get("status") == 200:
                  walk(
                      result.get("body"),
                      result["category"],
                      report["channels_found"],
                  )

          # Deduplicate identical channel records across genre responses.
          unique = {}
          for item in report["channels_found"]:
              record = item["record"]
              identity = (
                  str(record.get("id", "")),
                  str(record.get("key", "")),
                  str(record.get("title", record.get("name", ""))),
              )
              unique.setdefault(identity, item)

          report["channels_found"] = list(unique.values())
          report["unique_candidate_count"] = len(unique)

          os.makedirs("plex-fast-catalog-report", exist_ok=True)
          with open(
              "plex-fast-catalog-report/report.json",
              "w", encoding="utf-8"
          ) as file:
              json.dump(report, file, indent=2, ensure_ascii=False)

          print("\nSuccessful catalog routes:")
          for result in report["results"]:
              if result.get("status") == 200:
                  print(result["url"])

          print(
              "\nUnique candidate channel records:",
              report["unique_candidate_count"]
          )
          print("Full report saved.")
          PY

          python plex_fast_catalog_test.py

      - name: Upload catalog report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: plex-fast-catalog-report
          path: plex-fast-catalog-report/report.json
          if-no-files-found: warn
          retention-days: 7
